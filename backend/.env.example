# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── Vapi ──────────────────────────────────────────────────────────────────────
VAPI_API_KEY=your-vapi-private-api-key
VAPI_ASSISTANT_ID=                          # filled in after first run of setup_vapi_assistant.py
VAPI_SERVER_SECRET=your-vapi-webhook-shared-secret

# ── Groq (entered into Vapi Provider Keys page, NOT called by the backend) ────
GROQ_API_KEY=your-groq-api-key

# ── Public API URL ─────────────────────────────────────────────────────────────
# Locally: http://localhost:8000
# After Heroku deploy: https://your-app-name.herokuapp.com
PUBLIC_API_BASE_URL=http://localhost:8000
